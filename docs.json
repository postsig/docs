{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PostSig",
  "seo": {
    "metatags": {
      "robots": "noindex"
    }
  },
  "colors": {
    "primary": "#18162d",
    "light": "#ffffff",
    "dark": "#18162d"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "FK Grotesk",
      "source": "/fonts/FKGrotesk-Medium.woff2",
      "format": "woff2",
      "weight": 500
    },
    "body": {
      "family": "FK Grotesk Neue",
      "source": "/fonts/FKGroteskNeue-Regular.woff2",
      "format": "woff2"
    }
  },
  "redirects": [
    {
      "source": "/user-roles-permissions",
      "destination": "/access/roles",
      "permanent": true
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index"
            ]
          },
          {
            "group": "CPM",
            "pages": [
              "fields",
              {
                "group": "Contract Types",
                "pages": [
                  "contract-types",
                  "contract-types/msa",
                  "contract-types/so",
                  "contract-types/addendum",
                  "contract-types/other",
                  "contract-types/tos",
                  "contract-types/invoice",
                  "contract-types/trial",
                  "contract-types/operational",
                  "contract-types/nda"
                ]
              }
            ]
          },
          {
            "group": "Investor",
            "tag": "BETA",
            "pages": [
              "investor/index"
            ]
          },
          {
            "group": "MCP Servers",
            "pages": [
              "mcp-servers/cpm",
              "mcp-servers/investor"
            ]
          },
          {
            "group": "Access",
            "pages": [
              "access/roles",
              "access/permissions"
            ]
          }
        ]
      }
    ],
    "global": {}
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@postsig.com.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Login",
      "href": "https://app.postsig.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt"
    ]
  },
  "footer": {}
}
