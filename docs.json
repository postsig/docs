{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mint Starter Kit",
  "seo": {
    "metatags": {
      "robots": "noindex"
    }
  },
  "colors": {
    "primary": "#18162d",
    "light": "#ffffff",
    "dark": "#18162d"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "FK Grotesk",
      "source": "/fonts/FKGrotesk-Medium.woff2",
      "format": "woff2",
      "weight": 500
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "fields",
              {
                "group": "Contract Types",
                "pages": [
                  "contract-types",
                  "contract-types/msa.mdx",
                  "contract-types/so.mdx",
                  "contract-types/addendum.mdx",
                  "contract-types/other.mdx",
                  "contract-types/tos.mdx",
                  "contract-types/invoice.mdx",
                  "contract-types/trial.mdx",
                  "contract-types/operational.mdx",
                  "contract-types/nda.mdx"
                ]
              },
              "user-roles-permissions"
            ]
          }
        ]
      }
    ],
    "global": {}
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@postsig.com.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Login",
      "href": "https://app.postsig.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {}
}
